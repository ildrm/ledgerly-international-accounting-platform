NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://ledgerly_runtime:ledgerly_runtime_dev@localhost:5432/ledgerly
MIGRATION_DATABASE_URL=postgresql://ledgerly_migrator:ledgerly_migrator_dev@localhost:5432/ledgerly
DATABASE_POOL_MAX=10
SESSION_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=info
LEDGERLY_SEED_PROFILE=deterministic-development
REDIS_URL=redis://localhost:6379
LEDGERLY_API_BASE_URL=http://localhost:4000/
LEDGERLY_APP_ORIGIN=http://localhost:3000
LEDGERLY_ALLOW_LOCAL_AUTH=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=ledgerly-documents
S3_ACCESS_KEY=ledgerly_local
S3_SECRET_KEY=ledgerly_local_secret
SMTP_URL=smtp://localhost:1025
