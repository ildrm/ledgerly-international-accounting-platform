# Server-only upstream API origin. The browser talks only to the same-origin BFF.
LEDGERLY_API_BASE_URL=http://localhost:4000/

# Trusted public origin used for state-changing request origin checks.
LEDGERLY_APP_ORIGIN=http://localhost:3000

# Local development only. Hosted production always requires the platform identity headers.
LEDGERLY_ALLOW_LOCAL_AUTH=true
